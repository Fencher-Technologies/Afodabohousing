# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key



# Security
SECRET_KEY=your-super-secret-key-change-in-production
ENVIRONMENT=development

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW_SECONDS=60

# Retry settings
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=10.0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# Sentry (optional)
SENTRY_ENDPOINT=
SENTRY_DSN=
TESTING=false

# Pesapal (payment gateway) — required for boosts and subscription payments
# Get sandbox credentials from https://developer.pesapal.com
# Set PESAPAL_ENVIRONMENT=sandbox for testing, live for production
# PESAPAL_IPN_URL is the backend URL Pesapal sends payment notifications to
PESAPAL_CONSUMER_KEY=  # ← REQUIRED — set your Pesapal consumer key
PESAPAL_CONSUMER_SECRET=  # ← REQUIRED — set your Pesapal consumer secret
PESAPAL_ENVIRONMENT=sandbox
PESAPAL_IPN_URL=https://afodabohousing.onrender.com/payments/webhook/pesapal

# EgoSMS (for OTP delivery)
EGOSMS_USERNAME=
EGOSMS_PASSWORD=
EGOSMS_SENDER_ID=Afodabo
EGOSMS_URL=https://comms.egosms.co/api/v1/json/

# SMS provider
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_URL=https://api.example.com/sms/send

# Webhook security
# Where Supabase sends the password recovery link. Must also be listed in the
# Supabase dashboard under Authentication -> URL Configuration -> Redirect URLs,
# alongside the mobile deep link axis://reset-password
# Transactional email defaults to the Supabase `send-email` edge function,
# which holds the provider key as a Supabase secret — no backend config needed.
# Set RESEND_API_KEY and EMAIL_FROM in the Supabase dashboard under
# Edge Functions -> Secrets. Only set these two to bypass it and post to a
# provider directly.
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_API_KEY=

PASSWORD_RESET_REDIRECT_URL=https://afodabohousing.vercel.app/reset-password

WEBHOOK_SECRET=

# Mobile APK download (frontend VITE_MOBILE_APK_URL — set in Vercel env vars)
# VITE_MOBILE_APK_URL=https://your-storage.com/afodabo-housing.apk
