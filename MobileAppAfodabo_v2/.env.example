# Mobile App Configuration
# API Base URL — point to your backend
# For local development: use ngrok tunnel URL (e.g. https://abc123.ngrok-free.app)
# For production (Render): use the Render backend URL
EXPO_PUBLIC_API_URL=https://axishousing.onrender.com

# Optional: Pesapal callback URL for mobile payments
# If not set, defaults to EXPO_PUBLIC_API_URL
# EXPO_PUBLIC_PESAPAL_CALLBACK_URL=https://your-tunnel-url.ngrok-free.app